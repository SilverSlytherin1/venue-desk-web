{
  "name": "venue-desk-web",
  "version": "1.0.0",
  "description": "Angular frontend for Venue Desk: public seat booking and a staff work order desk.",
  "license": "MIT",
  "author": "Emanuel Pinto (https://riverdevstudio.it)",
  "private": true,
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "ng test",
    "test:ci": "ng test --no-watch",
    "e2e": "start-server-and-test start http://localhost:4200 e2e:run",
    "e2e:run": "cypress run"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "angular-eslint": "^21.4.0",
    "cypress": "16.1.1",
    "eslint": "^10.12.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "start-server-and-test": "^3.0.13",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vitest": {
      "vite": "^7.3.6"
    }
